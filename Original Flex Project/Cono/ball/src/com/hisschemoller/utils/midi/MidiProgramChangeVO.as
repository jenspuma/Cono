package com.hisschemoller.utils.midi{		/**	 * @author Wouter Hisschemöller	 * (c) May 13, 2009	 */	public class MidiProgramChangeVO extends MidiEventVO	{		public var number : uint;		public function MidiProgramChangeVO()		{			type = MidiEventType.PROGRAM_CHANGE;		}		override public function parseXML(o : XML) : Boolean		{			var success : Boolean = super.parseXML(o);						channel = o.*[1].@Channel;			number = o.*[1].@Number;						return success;		}	}}