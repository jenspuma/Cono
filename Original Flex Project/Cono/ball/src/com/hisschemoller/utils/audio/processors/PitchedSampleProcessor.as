package com.hisschemoller.utils.audio.processors {	import com.hisschemoller.utils.audio.vo.SoundVO;	import com.hisschemoller.model.AudioDriverProxy;	import com.hisschemoller.utils.Conversions;	import com.hisschemoller.utils.audio.vo.PitchedSampleProgramVO;	import flash.utils.ByteArray;	/**	 * Plays part of an MP3 file (a slice) from _startSampleIndex to _endSampleIndex.	 * 	 * @author Wouter Hisschemöller	 * (c) Apr 30, 2009	 */	public class PitchedSampleProcessor implements IAudioProcessor 	{		private const BYTE_ARRAY : ByteArray = new ByteArray();		private var _programVO : PitchedSampleProgramVO;		private var _deltaSamples : int;		private var _pitch : int;		private var _velocity : int;		private var _sourceByteArray : ByteArray;		private var _startSampleIndex : int;		private var _endSampleIndex : int;		private var _currentSampleIndexNum : Number;		private var _currentSampleIndexInt : int;		private var _relativeSampleIndex : int;		private var _numSamplesRequired : int;		private var _attackDuration : int = 50;		private var _decayDuration : int = 100;		private var _gain : Number = 1;		private var _level : Number = 0.3;		private var _rate : Number;		/**		 * @param presetVO : Sample preset data object.		 * @param deltaSamples : offset into the buffer where to start writing.		 */		public function PitchedSampleProcessor(programVO : PitchedSampleProgramVO, deltaSamples : int = 0, pitch : int = 60, velocity : int = 100)		{			_programVO = programVO;			_deltaSamples = deltaSamples;			_pitch = pitch;			_velocity = velocity;			_sourceByteArray = programVO.soundData.byteArray;			_startSampleIndex = programVO.start;			_endSampleIndex = programVO.end;			_currentSampleIndexNum = _startSampleIndex;			_rate = Conversions.semitoneToRate(_programVO.transpose);		}		/**		 * @param buffer : stereo buffer of AudioDriver.BUFFER_SIZE number of samples		 * @param bufferStartIndex: From where in the buffer to start to write.		 * @return Boolean : true if the playback is done and this generator can be removed		 */		public function process(buffer : Vector.<Vector.<Number>>, bufferStartIndex : uint) : Boolean		{			var scaledBufferSize : Number = AudioDriverProxy.BUFFER_BLOCK_SIZE * _rate;			_currentSampleIndexInt = _currentSampleIndexNum;			var alpha : Number = _currentSampleIndexNum - _currentSampleIndexInt;			var positionTargetNum : Number = alpha;			var positionTargetInt : int = -1;			/** Compute the number of samples needed to process one buffer (+2 for interpolation). */			_numSamplesRequired = Math.ceil(scaledBufferSize) + 2;						/** If the end of the slice is reached within the current buffer, adjust the samples to read. */			if(_currentSampleIndexInt + _numSamplesRequired <= _endSampleIndex)			{				var numSamplesAvailable : int = _numSamplesRequired;			}			else			{				numSamplesAvailable = _endSampleIndex - _currentSampleIndexInt;			}						/** Get the samples from the source audio ByteArray. */			BYTE_ARRAY.position = 0;			BYTE_ARRAY.writeBytes(_sourceByteArray, _currentSampleIndexInt * AudioDriverProxy.BYTES_PER_SAMPLE, numSamplesAvailable * AudioDriverProxy.BYTES_PER_SAMPLE);			BYTE_ARRAY.position = 0;						var l0 : Number;			var r0 : Number;			var l1 : Number;			var r1 : Number;						/**  */			var n : int = (numSamplesAvailable == _numSamplesRequired) ? AudioDriverProxy.BUFFER_BLOCK_SIZE : (numSamplesAvailable - 2) / _rate;						for(var i : int = _deltaSamples;i < n; ++i)			{				/** A short attack to remove clicks at the start of the slice */				if(_relativeSampleIndex + i < _attackDuration)				{					_gain = ((_relativeSampleIndex + i) / _attackDuration);				}								/** A short decay to remove clicks at the end of the slice. */				if(_endSampleIndex - _relativeSampleIndex + i < _decayDuration)				{ 					_gain = (_endSampleIndex - _relativeSampleIndex + i) / _decayDuration;				}								/** Avoid reading equal samples if _rate < 1.0. */				if(int(positionTargetNum) != positionTargetInt)				{					positionTargetInt = positionTargetNum;										/** Set BYTE_ARRAY read position. */					BYTE_ARRAY.position = positionTargetInt << 3;										/** Read two stereo samples (for linear interpolation). */					l0 = BYTE_ARRAY.readFloat();					r0 = BYTE_ARRAY.readFloat();					l1 = BYTE_ARRAY.readFloat();					r1 = BYTE_ARRAY.readFloat();				}								/** Add interpolated amplitudes to stream. */				var writePosition : int = i + bufferStartIndex;				buffer[0][writePosition] += (l0 + alpha * (l1 - l0)) * _level * _gain;				buffer[1][writePosition] += (r0 + alpha * (r1 - r0)) * _level * _gain;								/** Increase target position. */				positionTargetNum += _rate;								/** Increase fraction and clamp between 0 and 1. */				alpha += _rate;				while(alpha >= 1.0) --alpha;			}						/** If the slice is done, fill the rest of the buffer with silence. */			if(i < AudioDriverProxy.BUFFER_BLOCK_SIZE)			{				while(i < AudioDriverProxy.BUFFER_BLOCK_SIZE)				{					writePosition = i + bufferStartIndex;					buffer[0][writePosition] += 0.0;					buffer[1][writePosition] += 0.0;										++i;				}			}						_currentSampleIndexNum += scaledBufferSize - _deltaSamples;			_relativeSampleIndex = _currentSampleIndexNum - _startSampleIndex;			_deltaSamples = 0;						if(_currentSampleIndexNum >= _endSampleIndex) return true;						return false;		}				/**		 * 		 */		public function stop() : void		{			/** If possible leave the short decay to have a nice smooth end to the sound. */			_endSampleIndex = Math.min(_currentSampleIndexNum + _decayDuration, _endSampleIndex);		}				/**		 * 		 */		public function get pitch() : int		{			return _pitch;		}		/**		 * 		 */		public function get rate() : Number		{			return _rate;		}		public function set rate(value : Number) : void		{			if(value < 0.0) value = 0;			_rate = value;		}	}}