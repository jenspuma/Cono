<?xml version="1.0" encoding="utf-8" ?>
<s:SparkSkin 	xmlns:fx="http://ns.adobe.com/mxml/2009"
				xmlns:s="library://ns.adobe.com/flex/spark"
				xmlns:mx="library://ns.adobe.com/flex/mx"
				minWidth="120" minHeight="120">

    <fx:Metadata>
        [HostComponent("spark.components.ToggleButton")]
    </fx:Metadata>

    <s:states>
        <mx:State name="up"/>
        <mx:State name="down"/>
        <mx:State name="over"/>
        <mx:State name="disabled"/>
        <mx:State name="upAndSelected"/>
        <mx:State name="downAndSelected"/>
        <mx:State name="overAndSelected"/>
        <mx:State name="disabledAndSelected"/>
    </s:states>

    <s:Rect left="10" right="10" top="10" bottom="10" radiusX="5" radiusY="5">
        <s:stroke>
            <s:SolidColorStroke color="0xFFFFFF" weight="3"/>
        </s:stroke>
		<s:filters>
			<s:GlowFilter 
				color="0xFFFFFF" 
				alpha.down="1" 
				alpha.downAndSelected="1"
				alpha="0.5"
				blurX="6" 
				blurY="6" 
				strength="1" 
				quality="50"
				inner="false" 
				knockout="false"/>
		</s:filters>

    </s:Rect>
    
    <s:Rect left="10" right="10" top="10" bottom="10" radiusX="5" radiusY="5" includeIn="upAndSelected, overAndSelected, down, downAndSelected">
		<s:fill>
		<s:RadialGradient>
			<s:GradientEntry color="white" ratio="0.5" alpha="1"/>
            <s:GradientEntry color="white" ratio="1" 
							 alpha.down=".95" 
							 alpha.downAndSelected=".95" 
							 alpha.upAndSelected=".8" 
							 alpha.overAndSelected=".8"/>                   
		</s:RadialGradient>
		</s:fill>
    </s:Rect>

    <s:Label id="labelDisplay"
		fontFamily="verdana"
		fontSize="8"
		color="white"
        textAlign="center" verticalAlign="bottom"
		width="100%" height="100%"
        >
    </s:Label>
	
</s:SparkSkin>